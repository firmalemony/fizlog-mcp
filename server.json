{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.firmalemony/fizlog-mcp",
  "description": "Publish changelog entries to Fizlog (in-app widget, public page, RSS) from any MCP client.",
  "version": "0.1.0",
  "repository": { "url": "https://github.com/firmalemony/fizlog-mcp", "source": "github" },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fizlog-mcp",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        { "name": "FIZLOG_API_KEY", "description": "Project API key from fizlog.com", "isRequired": true, "isSecret": true },
        { "name": "FIZLOG_PUBLIC_KEY", "description": "Project public key (default for reading the changelog)", "isRequired": false },
        { "name": "FIZLOG_BASE_URL", "description": "Base URL for self-hosted Fizlog", "isRequired": false }
      ]
    }
  ]
}
